generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id                   String  @id
  title                String
  description          String?
  price                Float
  salePrice            Float?
  discountPercentage   Float?
  itemRating           Float?
  likes                Int?
  shopName             String?
  imageLink            String?
  productLink          String?
  category1            String?
  category2            String?
  category3            String?
}